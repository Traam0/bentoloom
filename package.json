{
  "name": "bentoloom",
  "version": "1.0.0-rc",
  "description": "Deterministic, seeded bento/mosaic layout engine for image galleries: gapless grids, irregular shapes, decorative filler tiles.",
  "keywords": [
    "gallery",
    "bento",
    "masonry",
    "layout",
    "treemap",
    "css-grid",
    "mosaic",
    "seeded"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check:package": "publint && attw --pack . --ignore-rules cjs-resolves-to-esm",
    "prepublishOnly": "npm run typecheck && npm run coverage && npm run build && npm run check:package",
    "docs:assets": "tsup && node scripts/make-assets.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@vitest/coverage-v8": "^5.0.3",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "typescript": "~5.9",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Traam0/bentoloom.git"
  },
  "homepage": "https://github.com/Traam0/bentoloom#readme",
  "bugs": {
    "url": "https://github.com/Traam0/bentoloom/issues"
  }
}
